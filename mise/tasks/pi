#!/usr/bin/env bash
#MISE description="Run project-local pi against the llama.cpp server"
set -euo pipefail

PI_BIN="./node_modules/.bin/pi"
if [[ ! -x "$PI_BIN" ]]; then
  echo "Local pi not installed. Run: mise run setup" >&2
  exit 1
fi

export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$PWD/.pi/agent}"
export LLAMA_BASE_URL="${LLAMA_BASE_URL:-http://127.0.0.1:9931}"
export LLAMA_API_KEY="${LLAMA_API_KEY:-dummy}"

BASE="$LLAMA_BASE_URL"
if ! curl -sf "$BASE/health" >/dev/null 2>&1 && ! curl -sf "$BASE/v1/models" >/dev/null 2>&1; then
  echo "llama.cpp server not reachable at $BASE" >&2
  echo "Start it in another terminal: mise run serve" >&2
  exit 1
fi

# Current pi: --model provider/id + --api-key. Endpoint comes from .pi/agent/models.json
# (not the old --api-base flag).
MODEL="${PI_MODEL:-local/qwen3.8-pi}"

echo "pi: $PI_BIN"
echo "model: $MODEL"
echo "agent: $PI_CODING_AGENT_DIR"
echo "server: $BASE"

exec "$PI_BIN" --model "$MODEL" --api-key "$LLAMA_API_KEY" "$@"
