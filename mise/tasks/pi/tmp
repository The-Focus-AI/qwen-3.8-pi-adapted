#!/usr/bin/env bash
#MISE description="mktemp -d, symlink .pi plugins, print path, run pi there"
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
PI_BIN="$ROOT/node_modules/.bin/pi"
if [[ ! -x "$PI_BIN" ]]; then
  echo "Local pi not installed. Run: mise run setup" >&2
  exit 1
fi

export LLAMA_BASE_URL="${LLAMA_BASE_URL:-http://127.0.0.1:9931}"
export LLAMA_API_KEY="${LLAMA_API_KEY:-dummy}"
# Project package CLIs (subagent, etc.)
export PATH="$ROOT/node_modules/.bin:$ROOT/.pi/agent/bin:${PATH:-}"

BASE="$LLAMA_BASE_URL"
if ! curl -sf "$BASE/health" >/dev/null 2>&1 && ! curl -sf -H "Authorization: Bearer $LLAMA_API_KEY" "$BASE/v1/models" >/dev/null 2>&1; then
  echo "llama.cpp server not reachable at $BASE" >&2
  echo "Start it in another terminal: mise run serve" >&2
  exit 1
fi

if [[ ! -d "$ROOT/.pi" ]]; then
  echo "Missing $ROOT/.pi — run: mise run setup" >&2
  exit 1
fi

MODEL="${PI_MODEL:-local/qwen3.8-pi}"
WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/pi-scratch.XXXXXX")"

# Project-local packages (pi-lens, pi-subagent, pi-llama) are discovered from
# cwd/.pi/settings.json — symlink the repo .pi so plugins load in the scratch dir.
ln -sfn "$ROOT/.pi" "$WORKDIR/.pi"

# Agent dir via the symlink so sessions/trust still live in the repo .pi/agent
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$WORKDIR/.pi/agent}"

echo "workdir: $WORKDIR"
echo "pi:      $PI_BIN"
echo "model:   $MODEL"
echo ".pi:     $WORKDIR/.pi -> $ROOT/.pi"
echo "agent:   $PI_CODING_AGENT_DIR"
echo "server:  $BASE"
if [[ $# -gt 0 ]]; then
  echo "prompt:  $*"
fi
echo
echo "(tools run in workdir; packages/settings via symlinked .pi)"
echo

cd "$WORKDIR"
exec "$PI_BIN" --model "$MODEL" --api-key "$LLAMA_API_KEY" --approve "$@"
