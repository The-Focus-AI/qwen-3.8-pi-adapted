#!/usr/bin/env bash
#MISE description="Install llama.cpp (brew), local pi (npm), and project extensions"
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

# --- llama.cpp (Homebrew) ---------------------------------------------------
if command -v llama-server >/dev/null 2>&1; then
  echo "llama-server found: $(command -v llama-server)"
else
  if ! command -v brew >/dev/null 2>&1; then
    echo "llama-server not found and Homebrew is missing. Install brew, then re-run: mise run setup" >&2
    exit 1
  fi
  echo "llama-server not found — installing llama.cpp via Homebrew..."
  brew install llama.cpp
  if ! command -v llama-server >/dev/null 2>&1; then
    echo "brew install llama.cpp finished but llama-server is still not on PATH." >&2
    exit 1
  fi
  echo "llama-server ready: $(command -v llama-server)"
fi

# --- Size llama.cpp context for this machine --------------------------------
# Writes mise.local.toml (gitignored) so `mise run serve` picks up CONTEXT.
detect_context() {
  local mem_bytes mem_gb model_path model_bytes model_gb reserve_gb budget chip ctx

  mem_bytes=$(sysctl -n hw.memsize 2>/dev/null || true)
  if [[ -z "${mem_bytes:-}" || "$mem_bytes" == "0" ]]; then
    # Fallback when sysctl is blocked or unavailable (e.g. some sandboxes)
    mem_bytes=$(python3 - <<'PY' 2>/dev/null || true
import os, re, subprocess
try:
    out = subprocess.check_output(["sysctl", "-n", "hw.memsize"], text=True).strip()
    print(int(out))
except Exception:
    try:
        # macOS system_profiler
        sp = subprocess.check_output(["system_profiler", "SPHardwareDataType"], text=True)
        m = re.search(r"Memory:\s+(\d+)\s*GB", sp)
        print(int(m.group(1)) * 1024**3 if m else 0)
    except Exception:
        print(0)
PY
)
  fi
  mem_bytes=${mem_bytes:-0}
  mem_gb=$(( mem_bytes / 1024 / 1024 / 1024 ))
  chip=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo unknown)
  if [[ "$chip" == "unknown" ]]; then
    chip=$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Chip:/{print $2; exit}' || echo unknown)
  fi

  # Prefer the default serve quant (Q4) when present; else Q8; else env MODEL.
  if [[ -n "${MODEL:-}" ]]; then
    model_path="$MODEL"
  elif [[ -f weights/Qwen3.8-27B-Q4_K_M.gguf ]]; then
    model_path="weights/Qwen3.8-27B-Q4_K_M.gguf"
  elif [[ -f weights/Qwen3.8-27B-Q8_0.gguf ]]; then
    model_path="weights/Qwen3.8-27B-Q8_0.gguf"
  else
    model_path="weights/Qwen3.8-27B-Q4_K_M.gguf"
  fi
  model_gb=16
  if [[ -f "$model_path" ]]; then
    model_bytes=$(stat -f%z "$model_path" 2>/dev/null || stat -c%s "$model_path" 2>/dev/null || echo 0)
    if (( model_bytes > 0 )); then
      model_gb=$(( (model_bytes + 1024*1024*1024 - 1) / (1024*1024*1024) ))
    fi
  fi

  # Unified-memory headroom: macOS + UI + runtime scratch
  reserve_gb="${RESERVE_GB:-16}"
  budget=$(( mem_gb - model_gb - reserve_gb ))
  if (( budget < 2 )); then
    budget=2
  fi

  # Always recompute from this machine. Existing mise.local.toml exports
  # CONTEXT into the env, so manual pins use CONTEXT_OVERRIDE instead.
  # Example: CONTEXT_OVERRIDE=65536 mise run setup
  if [[ -n "${CONTEXT_OVERRIDE:-}" ]]; then
    ctx="$CONTEXT_OVERRIDE"
  elif (( mem_gb == 0 )); then
    echo "Warning: could not read system memory; defaulting CONTEXT=32768" >&2
    echo "         Re-run setup, or: CONTEXT_OVERRIDE=<n> mise run setup" >&2
    ctx=32768
  elif (( budget >= 40 )); then
    ctx=262144
  elif (( budget >= 20 )); then
    ctx=131072
  elif (( budget >= 10 )); then
    ctx=65536
  elif (( budget >= 5 )); then
    ctx=32768
  else
    ctx=16384
  fi

  cat > mise.local.toml <<EOF
# Generated by \`mise run setup\` for this machine — do not commit.
# Re-run setup after changing RAM/weights, or:
#   CONTEXT_OVERRIDE=<n> mise run setup
[env]
CONTEXT = "$ctx"
EOF

  echo "Machine: ${chip}"
  echo "Memory:  ${mem_gb} GB unified"
  echo "Model:   ~${model_gb} GB (${model_path})"
  echo "Reserve: ${reserve_gb} GB headroom → ~${budget} GB for KV"
  echo "CONTEXT: ${ctx} tokens (wrote mise.local.toml)"
  echo "         Override: CONTEXT_OVERRIDE=<n> mise run setup"
}

detect_context

# --- Node deps (local pi) ---------------------------------------------------
install_js() {
  if [[ -f pnpm-lock.yaml ]] && command -v pnpm >/dev/null 2>&1; then
    echo "Installing JS deps with pnpm..."
    pnpm install
  elif [[ -f yarn.lock ]] && command -v yarn >/dev/null 2>&1; then
    echo "Installing JS deps with yarn..."
    yarn install
  else
    echo "Installing JS deps with npm..."
    npm install --ignore-scripts
  fi
}

install_js

PI_BIN="./node_modules/.bin/pi"
if [[ ! -x "$PI_BIN" ]]; then
  echo "Local pi binary missing after install: $PI_BIN" >&2
  echo "Ensure @earendil-works/pi-coding-agent is in package.json dependencies." >&2
  exit 1
fi

echo "Using local pi: $PI_BIN ($("$PI_BIN" --version 2>/dev/null || echo unknown))"

# --- Project-local agent models (openai-compatible → llama-server) ----------
mkdir -p .pi/agent
if [[ ! -f .pi/agent/models.json ]]; then
  cat > .pi/agent/models.json <<'EOF'
{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "local": {
      "baseUrl": "http://127.0.0.1:9931/v1",
      "api": "openai-completions",
      "apiKey": "dummy",
      "models": [
        {
          "id": "qwen3.8-pi",
          "name": "Qwen3.8 Pi-adapted (LoRA)"
        }
      ]
    }
  }
}
EOF
  echo "Wrote .pi/agent/models.json"
else
  echo "models.json present: .pi/agent/models.json"
fi

# --- Project-local pi packages (.pi/settings.json; clones reinstall via setup) ---
# Package payloads live under .pi/git/ and .pi/npm/ (gitignored). settings.json
# lists what to install; always re-run so a fresh clone gets them.
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$PWD/.pi/agent}"

install_pi_pkg() {
  local src="$1"
  echo "Ensuring project-local package: $src"
  # --approve: trust project .pi for this non-interactive install
  "$PI_BIN" install -l --approve "$src"
}

install_pi_pkg "git:github.com/huggingface/pi-llama"
install_pi_pkg "npm:pi-lens"
install_pi_pkg "git:github.com/badlogic/pi-subagent"

# pi-lens needs @ast-grep/cli native binary. Prefer rebuild; install-scripts is
# only on newer npm and is not available on npm 11.
if [[ -d .pi/npm/node_modules/@ast-grep/cli ]]; then
  echo "Rebuilding @ast-grep/cli for pi-lens..."
  (cd .pi/npm && npm rebuild @ast-grep/cli >/dev/null 2>&1 || true)
fi

if [[ -d .pi/npm/node_modules/pi-lens ]]; then
  echo "pi-lens ready: .pi/npm/node_modules/pi-lens (project-local only)"
else
  echo "Warning: pi-lens not found under .pi/npm after install" >&2
fi

# pi-subagent: CLI must be on PATH; package also needs tmux at runtime.
SUBAGENT_SRC=".pi/git/github.com/badlogic/pi-subagent/subagent.ts"
mkdir -p .pi/agent/bin
if [[ -f "$SUBAGENT_SRC" ]]; then
  ln -sfn "$(cd "$(dirname "$SUBAGENT_SRC")" && pwd)/subagent.ts" .pi/agent/bin/subagent
  chmod +x .pi/agent/bin/subagent "$SUBAGENT_SRC" 2>/dev/null || true
  echo "subagent CLI: .pi/agent/bin/subagent -> $SUBAGENT_SRC"
else
  echo "Warning: pi-subagent source missing after install" >&2
fi

if command -v tmux >/dev/null 2>&1; then
  echo "tmux found: $(command -v tmux) ($(tmux -V 2>/dev/null || true))"
else
  if command -v brew >/dev/null 2>&1; then
    echo "tmux not found — installing via Homebrew (required by pi-subagent)..."
    brew install tmux
  else
    echo "Warning: tmux missing; pi-subagent spawn will fail until you install it." >&2
  fi
fi

echo
echo "Setup complete."
echo "  mise run serve   # start llama.cpp with Pi LoRA (uses CONTEXT from mise.local.toml)"
echo "  mise run pi      # talk to it via local pi (model: local/qwen3.8-pi)"
echo "  mise run pi:tmp  # scratch dir + pi (pi-lens + subagent; start a fresh session after setup)"
