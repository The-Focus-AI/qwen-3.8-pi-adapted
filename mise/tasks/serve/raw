#!/usr/bin/env bash
#MISE description="Start llama.cpp with base Qwen only (no LoRA)"
set -euo pipefail

WEIGHTS="${WEIGHTS:-weights}"
MODEL="${MODEL:-$WEIGHTS/Qwen3.8-27B-Q8_0.gguf}"
PORT="${PORT:-9931}"
ALIAS="${ALIAS:-qwen3.8}"
CONTEXT="${CONTEXT:-32768}"

if [[ ! -f "$MODEL" ]]; then
  echo "Base model not found: $MODEL — run: mise run download:model" >&2
  exit 1
fi

echo "Model:   $MODEL"
echo "Port:    $PORT"
echo "Alias:   $ALIAS"
echo "Context: $CONTEXT"
echo "(no LoRA)"
if [[ ! -f mise.local.toml ]]; then
  echo "(tip: run mise run setup to size CONTEXT for this machine)" >&2
fi

exec llama-server \
  -m "$MODEL" \
  --reasoning off \
  -c "$CONTEXT" \
  --port "$PORT" \
  --alias "$ALIAS"
