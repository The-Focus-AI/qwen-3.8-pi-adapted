#!/usr/bin/env bash
#MISE description="Start llama.cpp with tuned Qwen + Pi LoRA (auto-downloads weights if missing)"
set -euo pipefail

WEIGHTS="${WEIGHTS:-weights}"
QUANT="${QUANT:-q4}"
# Default: Q4_K_M (hill-climb winner, 2026-11-17). Override with MODEL=... or QUANT=q8|q5|q3
if [[ -z "${MODEL:-}" ]]; then
  case "$(echo "$QUANT" | tr '[:upper:]' '[:lower:]')" in
    q8|q8_0) MODEL="$WEIGHTS/Qwen3.8-27B-Q8_0.gguf" ;;
    q5|q5_k_m) MODEL="$WEIGHTS/Qwen3.8-27B-Q5_K_M.gguf" ;;
    q4|q4_k_m) MODEL="$WEIGHTS/Qwen3.8-27B-Q4_K_M.gguf" ;;
    q3|q3_k_m) MODEL="$WEIGHTS/Qwen3.8-27B-Q3_K_M.gguf" ;;
    *) echo "Unknown QUANT=$QUANT" >&2; exit 1 ;;
  esac
fi
PORT="${PORT:-9931}"
ALIAS="${ALIAS:-qwen3.8-pi}"
# Set by `mise run setup` → mise.local.toml; override with CONTEXT=...
CONTEXT="${CONTEXT:-32768}"

mkdir -p "$WEIGHTS"

if [[ ! -f "$MODEL" ]]; then
  echo "Base model missing: $MODEL — downloading (QUANT=$QUANT) ..."
  QUANT="$QUANT" mise run download:model
fi

ADAPTER="${ADAPTER:-}"
if [[ -z "$ADAPTER" ]]; then
  ADAPTER=$(ls "$WEIGHTS"/*lora*.gguf "$WEIGHTS"/*adapter*.gguf 2>/dev/null | head -n 1 || true)
fi

if [[ -z "$ADAPTER" || ! -f "$ADAPTER" ]]; then
  echo "No LoRA adapter found — downloading ..."
  mise run download:adapter
  ADAPTER=$(ls "$WEIGHTS"/*lora*.gguf "$WEIGHTS"/*adapter*.gguf 2>/dev/null | head -n 1 || true)
fi

if [[ -z "$ADAPTER" || ! -f "$ADAPTER" ]]; then
  echo "LoRA adapter still missing after download." >&2
  exit 1
fi

if [[ ! -f "$MODEL" ]]; then
  echo "Base model still missing after download: $MODEL" >&2
  exit 1
fi

echo "Model:   $MODEL"
echo "Adapter: $ADAPTER"
echo "Port:    $PORT"
echo "Alias:   $ALIAS"
echo "Context: $CONTEXT"
if [[ ! -f mise.local.toml ]]; then
  echo "(tip: run mise run setup to size CONTEXT for this machine)" >&2
fi

exec llama-server \
  -m "$MODEL" \
  --lora "$ADAPTER" \
  --reasoning off \
  -c "$CONTEXT" \
  --port "$PORT" \
  --alias "$ALIAS"
