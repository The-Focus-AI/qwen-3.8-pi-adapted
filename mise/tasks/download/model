#!/usr/bin/env bash
#MISE description="Download base Qwen3.8-27B GGUF into weights/ (QUANT=q8|q4 or MODEL_NAME=...)"
set -euo pipefail

WEIGHTS="${WEIGHTS:-weights}"
REPO="${MODEL_REPO:-ggml-org/Qwen3.8-27B-GGUF}"

# QUANT selects a known file; MODEL_NAME still wins if set explicitly.
# Default q4 after local hill-climb (2026-11-17). Use QUANT=q8 for original.
QUANT="${QUANT:-q4}"
case "${MODEL_NAME:-}" in
  "")
    case "$(echo "$QUANT" | tr '[:upper:]' '[:lower:]')" in
      q8|q8_0) MODEL_NAME="Qwen3.8-27B-Q8_0.gguf" ;;
      q5|q5_k_m) MODEL_NAME="Qwen3.8-27B-Q5_K_M.gguf" ;;
      q4|q4_k_m) MODEL_NAME="Qwen3.8-27B-Q4_K_M.gguf" ;;
      q3|q3_k_m) MODEL_NAME="Qwen3.8-27B-Q3_K_M.gguf" ;;
      *)
        echo "Unknown QUANT=$QUANT (use q8, q5, q4, q3, or set MODEL_NAME=...)" >&2
        echo "Tip: local files via: TYPE=all mise run quantize" >&2
        exit 1
        ;;
    esac
    ;;
esac

MODEL="$WEIGHTS/$MODEL_NAME"

mkdir -p "$WEIGHTS"

if [[ -f "$MODEL" ]]; then
  echo "Already present: $MODEL"
  exit 0
fi

# Prefer local requant from Q8 when the file isn't on the Hub (q3/q5) or QUANT requests local.
if [[ "$MODEL_NAME" == "Qwen3.8-27B-Q3_K_M.gguf" || "$MODEL_NAME" == "Qwen3.8-27B-Q5_K_M.gguf" ]]; then
  echo "$MODEL_NAME not published on $REPO — building locally via llama-quantize"
  TYPE="$(echo "$QUANT" | tr '[:upper:]' '[:lower:]')" mise run quantize
  exit 0
fi

echo "Downloading $MODEL_NAME from $REPO → $WEIGHTS/ ..."
echo "(Or: TYPE=q4 mise run quantize  to requant locally from Q8)"
hf download "$REPO" "$MODEL_NAME" --local-dir "$WEIGHTS"
echo "Done: $MODEL"
